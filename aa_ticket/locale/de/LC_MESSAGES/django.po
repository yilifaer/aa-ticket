#: access.py:162
#, python-format
msgctxt "aa_ticket"
msgid "This ticket is handled by %(name)s. You can write an internal note."
msgstr ""
"Dieses Ticket wird von %(name)s bearbeitet. Du kannst eine interne Notiz "
"schreiben."

#: access.py:168
msgctxt "aa_ticket"
msgid ""
"Your department is helping with this ticket. You can write an internal note; "
"the responsible department replies to the requester."
msgstr ""
"Deine Abteilung hilft bei diesem Ticket. Du kannst eine interne Notiz "
"schreiben; die zuständige Abteilung antwortet dem Ersteller."

#: access.py:171
msgctxt "aa_ticket"
msgid "Claim the ticket to reply to the requester."
msgstr "Übernimm das Ticket, um dem Ersteller zu antworten."

#: attachments.py:49
msgctxt "aa_ticket"
msgid "Only PNG, JPG, GIF and WEBP images are allowed."
msgstr "Es sind nur PNG-, JPG-, GIF- und WEBP-Bilder erlaubt."

#: attachments.py:57
#, python-format
msgctxt "aa_ticket"
msgid ""
"This image is too large (%(width)d × %(height)d pixels). Images up to "
"%(max)d megapixels are accepted. Please use a smaller image."
msgstr ""
"Dieses Bild ist zu groß (%(width)d × %(height)d Pixel). Bilder bis %(max)d "
"Megapixel werden angenommen. Bitte verwende ein kleineres Bild."

#: attachments.py:62
msgctxt "aa_ticket"
msgid "This image is too large. Please make it smaller and try again."
msgstr "Dieses Bild ist zu groß. Bitte verkleinere es und versuche es erneut."

#: attachments.py:69
#, python-format
msgctxt "aa_ticket"
msgid ""
"This animation is too large in total (%(count)d frames of %(width)d × "
"%(height)d pixels). All frames together may have up to %(max)d megapixels. "
"Use fewer frames or a smaller size."
msgstr ""
"Diese Animation ist insgesamt zu groß (%(count)d Frames mit je %(width)d × "
"%(height)d Pixel). Alle Frames zusammen dürfen höchstens %(max)d Megapixel "
"haben. Verwende weniger Frames oder eine kleinere Größe."

#: attachments.py:105
#, python-format
msgctxt "aa_ticket"
msgid ""
"This animation has too many frames (%(count)d). Up to %(max)d frames are "
"allowed."
msgstr ""
"Diese Animation hat zu viele Einzelbilder (%(count)d). Erlaubt sind "
"höchstens %(max)d."

#: attachments.py:134 attachments.py:210
#, python-format
msgctxt "aa_ticket"
msgid "You can attach at most %(count)d images per message."
msgstr "Du kannst höchstens %(count)d Bilder pro Nachricht anhängen."

#: attachments.py:139 attachments.py:216
#, python-format
msgctxt "aa_ticket"
msgid "Each image must be smaller than %(size)d MB."
msgstr "Jedes Bild muss kleiner als %(size)d MB sein."

