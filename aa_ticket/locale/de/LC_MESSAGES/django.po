msgid "department"
msgstr "Abteilung"

#: models/config.py:93
msgid "departments"
msgstr "Abteilungen"

#: models/config.py:128
msgid "A department cannot be its own parent."
msgstr "Eine Abteilung kann nicht ihre eigene übergeordnete Abteilung sein."

#: models/config.py:131
msgid "This parent would create a loop. Pick a department above this one."
msgstr ""
"Diese übergeordnete Abteilung würde eine Schleife erzeugen. Wähle eine "
"Abteilung oberhalb dieser."

#: models/config.py:145
msgid "colour"
msgstr "Farbe"

#: models/config.py:146
msgid "Higher means more urgent."
msgstr "Höher bedeutet dringender."

#: models/config.py:148
msgid "mention roles for new tickets"
msgstr "Rollen bei neuen Tickets erwähnen"

#: models/config.py:150
msgid ""
"When on, new tickets with this priority mention the department's Discord "
"roles."
msgstr ""
"Wenn an, erwähnen neue Tickets mit dieser Priorität die Discord-Rollen der "
"Abteilung."

#: models/config.py:153
msgid "remind after (minutes)"
msgstr "Erinnern nach (Minuten)"

#: models/config.py:157
msgid ""
"Mention the department again if nobody claims the ticket in time. Leave "
"empty to turn off."
msgstr ""
"Die Abteilung erneut erwähnen, wenn niemand das Ticket rechtzeitig "
"übernimmt. Leer lassen, um es auszuschalten."

#: models/config.py:160
msgid "escalate after (minutes)"
msgstr "Eskalieren nach (Minuten)"

#: models/config.py:164
msgid ""
"Mention the parent department if nobody claims the ticket in time. Leave "
"empty to turn off."
msgstr ""
"Die übergeordnete Abteilung erwähnen, wenn niemand das Ticket rechtzeitig "
"übernimmt. Leer lassen, um es auszuschalten."

#: models/config.py:171
msgid "priority"
msgstr "Priorität"

#: models/config.py:172
msgid "priorities"
msgstr "Prioritäten"

#: models/config.py:184
msgid "template"
msgstr "Vorlage"

