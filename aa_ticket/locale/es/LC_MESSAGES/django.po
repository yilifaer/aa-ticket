msgctxt "aa_ticket"
msgid "states allowed to submit"
msgstr "estados con permiso para enviar"

#: models/config.py:64
msgctxt "aa_ticket"
msgid "Leave both lists empty to allow everyone who can use tickets."
msgstr ""
"Deja ambas listas vacías para permitirlo a todos los que puedan usar "
"tickets."

#: models/config.py:68
msgctxt "aa_ticket"
msgid "groups allowed to submit"
msgstr "grupos con permiso para enviar"

#: models/config.py:73
msgctxt "aa_ticket"
msgid "accepts tickets from players"
msgstr "acepta tickets de jugadores"

#: models/config.py:75
msgctxt "aa_ticket"
msgid ""
"When off, tickets can only reach this department by transfer or invitation."
msgstr ""
"Si está desactivado, los tickets solo llegan a este departamento por "
"transferencia o invitación."

