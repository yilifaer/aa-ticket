msgid "Only PNG, JPG, GIF and WEBP images are allowed."
msgstr "Solo se permiten imágenes PNG, JPG, GIF y WEBP."

#: attachments.py:43
#, python-format
msgctxt "aa_ticket"
msgid ""
"This image is too large (%(width)d × %(height)d pixels). Please make it "
