#: models/config.py:41
msgctxt "aa_ticket"
msgid "Shown to players when they pick a department."
msgstr "Se muestra a los jugadores al elegir un departamento."

#: models/config.py:45
msgctxt "aa_ticket"
msgid "parent department"
msgstr "departamento superior"

#: models/config.py:50
msgctxt "aa_ticket"
msgid "Staff of the parent department can see all tickets of this department."
msgstr ""
"El personal del departamento superior puede ver todos los tickets de este "
"departamento."

#: models/config.py:54
msgctxt "aa_ticket"
msgid "staff groups"
msgstr "grupos de personal"

#: models/config.py:57
msgctxt "aa_ticket"
msgid "Members of these groups are staff of this department."
msgstr "Los miembros de estos grupos son personal de este departamento."

#: models/config.py:61
msgctxt "aa_ticket"
msgid "states allowed to submit"
msgstr "estados con permiso para enviar"

#: models/config.py:64
msgctxt "aa_ticket"
msgid "Leave both lists empty to allow everyone who can use tickets."
msgstr ""
"Deja ambas listas vacías para permitirlo a todos los que puedan usar tickets."

#: models/config.py:68
msgctxt "aa_ticket"
msgid "groups allowed to submit"
msgstr "grupos con permiso para enviar"

#: models/config.py:73
msgctxt "aa_ticket"
msgid "accepts tickets from players"
msgstr "acepta tickets de jugadores"

#: models/config.py:75
msgctxt "aa_ticket"
msgid ""
"When off, tickets can only reach this department by transfer or invitation."
msgstr ""
"Si está desactivado, los tickets solo llegan a este departamento por "
"transferencia o invitación."

#: models/config.py:77 models/config.py:171 models/config.py:192
msgctxt "aa_ticket"
msgid "active"
msgstr "activo"

#: models/config.py:78 models/config.py:146 models/config.py:191
