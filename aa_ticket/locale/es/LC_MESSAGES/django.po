#: access.py:162
#, python-format
msgctxt "aa_ticket"
msgid "This ticket is handled by %(name)s. You can write an internal note."
msgstr "Este ticket lo gestiona %(name)s. Puedes escribir una nota interna."

#: access.py:168
msgctxt "aa_ticket"
msgid ""
"Your department is helping with this ticket. You can write an internal note; "
"the responsible department replies to the requester."
msgstr ""
"Tu departamento está ayudando con este ticket. Puedes escribir una nota "
"interna; el departamento responsable responde al solicitante."

#: access.py:171
msgctxt "aa_ticket"
msgid "Claim the ticket to reply to the requester."
msgstr "Asume el ticket para responder al solicitante."

#: attachments.py:38
msgctxt "aa_ticket"
msgid "Only PNG, JPG, GIF and WEBP images are allowed."
msgstr "Solo se permiten imágenes PNG, JPG, GIF y WEBP."

#: attachments.py:46
#, python-format
msgctxt "aa_ticket"
msgid ""
"This image is too large (%(width)d × %(height)d pixels). Images up to "
"%(max)d megapixels are accepted. Please use a smaller image."
msgstr ""
"Esta imagen es demasiado grande (%(width)d × %(height)d píxeles). Se aceptan "
"imágenes de hasta %(max)d megapíxeles. Usa una imagen más pequeña."

#: attachments.py:51
msgctxt "aa_ticket"
msgid "This image is too large. Please make it smaller and try again."
msgstr "Esta imagen es demasiado grande. Redúcela e inténtalo de nuevo."

#: attachments.py:58
#, python-format
msgctxt "aa_ticket"
msgid ""
"This animation is too large in total (%(count)d frames of %(width)d × "
"%(height)d pixels). All frames together may have up to %(max)d megapixels. "
"Use fewer frames or a smaller size."
msgstr ""
"Esta animación es demasiado grande en total (%(count)d fotogramas de "
"%(width)d × %(height)d píxeles). Todos los fotogramas juntos pueden tener "
"como máximo %(max)d megapíxeles. Usa menos fotogramas o un tamaño menor."

#: attachments.py:91
#, python-format
msgctxt "aa_ticket"
msgid ""
"This animation has too many frames (%(count)d). Up to %(max)d frames are "
"allowed."
msgstr ""
"Esta animación tiene demasiados fotogramas (%(count)d). Se permiten como "
"máximo %(max)d."

#: attachments.py:120 attachments.py:196
#, python-format
msgctxt "aa_ticket"
msgid "You can attach at most %(count)d images per message."
msgstr "Puedes adjuntar como máximo %(count)d imágenes por mensaje."

#: attachments.py:125 attachments.py:202
#, python-format
msgctxt "aa_ticket"
msgid "Each image must be smaller than %(size)d MB."
msgstr "Cada imagen debe pesar menos de %(size)d MB."

