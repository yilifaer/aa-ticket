msgid "Remove the webhook"
msgstr "Eliminar el webhook"

#: forms.py:66
msgctxt "aa_ticket"
msgid ""
"In Discord, enable Developer Mode, right-click the role and choose 'Copy "
"Role ID'. Separate several IDs with commas."
msgstr ""
"En Discord, activa el Modo desarrollador, haz clic derecho en el rol y elige "
"«Copiar ID del rol». Separa varios ID con comas."

#: forms.py:87
msgctxt "aa_ticket"
msgid "Another department already has this name. Please pick a different one."
msgstr "Ya existe otro departamento con este nombre. Elige uno distinto."

#: forms.py:98
msgctxt "aa_ticket"
msgid ""
"This department still has active sub-departments. Deactivate or move them "
"first."
msgstr ""
"Este departamento todavía tiene subdepartamentos activos. Desactívalos o "
"muévelos primero."

#: forms.py:105
#, python-format
msgctxt "aa_ticket"
msgid ""
"This department still has %(count)d open ticket. Transfer or close it before "
"deactivating the department."
msgid_plural ""
"This department still has %(count)d open tickets. Transfer or close them "
"before deactivating the department."
msgstr[0] ""
"Este departamento todavía tiene %(count)d ticket abierto. Transfiérelo o "
"ciérralo antes de desactivar el departamento."
msgstr[1] ""
"Este departamento todavía tiene %(count)d tickets abiertos. Transfiérelos o "
"ciérralos antes de desactivar el departamento."

#: forms.py:159
#, python-format
msgctxt "aa_ticket"
msgid ""
"%(count)d open ticket still uses this priority. Change its priority or close "
"it first."
msgid_plural ""
"%(count)d open tickets still use this priority. Change their priority or "
"close them first."
msgstr[0] ""
"%(count)d ticket abierto todavía usa esta prioridad. Cambia su prioridad o "
"ciérralo primero."
msgstr[1] ""
"%(count)d tickets abiertos todavía usan esta prioridad. Cambia su prioridad "
"o ciérralos primero."

#: forms.py:211
#, python-format
msgctxt "aa_ticket"
msgid ""
"The warning time must be shorter than the auto-close time (%(hours)d hours)."
msgstr ""
"El aviso debe ser anterior al cierre automático (menos de %(hours)d horas)."

#: models/config.py:21
msgctxt "aa_ticket"
msgid "Enter Discord role IDs as numbers, separated by commas or spaces."
msgstr ""
"Introduce los ID de rol de Discord como números, separados por comas o "
"espacios."

#: models/config.py:39 models/config.py:144 models/config.py:187
