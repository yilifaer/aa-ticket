msgid "Pre-filled into the ticket text when a player picks this category."
msgstr ""
"Se rellena en el texto del ticket cuando un jugador elige esta categoría."

#: models/config.py:192
msgctxt "aa_ticket"
msgid "category"
msgstr "categoría"

#: models/config.py:193
msgctxt "aa_ticket"
msgid "categories"
