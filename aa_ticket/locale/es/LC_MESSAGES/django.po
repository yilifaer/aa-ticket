msgstr ""
"En Discord, activa el Modo desarrollador, haz clic derecho en el rol y elige"
" «Copiar ID del rol». Separa varios ID con comas."

#: forms.py:89
#, python-format
msgctxt "aa_ticket"
msgid ""
"This department still has %(count)d open tickets. Transfer or close them "
"before deactivating it."
msgstr ""
"Este departamento todavía tiene %(count)d tickets abiertos. Transfiérelos o "
"ciérralos antes de desactivarlo."

#: models/config.py:21
msgctxt "aa_ticket"
msgid "Enter Discord role IDs as numbers, separated by commas or spaces."
msgstr ""
"Introduce los ID de rol de Discord como números, separados por comas o "
"espacios."

#: models/config.py:39 models/config.py:144 models/config.py:182
