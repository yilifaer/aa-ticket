msgid "departments"
msgstr "departamentos"

#: models/config.py:128
msgctxt "aa_ticket"
msgid "A department cannot be its own parent."
msgstr "Un departamento no puede ser su propio departamento superior."

#: models/config.py:131
msgctxt "aa_ticket"
msgid "This parent would create a loop. Pick a department above this one."
msgstr ""
"Este departamento superior crearía un bucle. Elige un departamento por "
"encima de este."

#: models/config.py:145
msgctxt "aa_ticket"
msgid "colour"
msgstr "color"

#: models/config.py:146
msgctxt "aa_ticket"
msgid "Higher means more urgent."
msgstr "Un valor más alto es más urgente."

#: models/config.py:148
msgctxt "aa_ticket"
msgid "mention roles for new tickets"
msgstr "mencionar roles en tickets nuevos"

#: models/config.py:150
msgctxt "aa_ticket"
msgid ""
"When on, new tickets with this priority mention the department's Discord "
"roles."
msgstr ""
"Si está activado, los tickets nuevos con esta prioridad mencionan los roles "
"de Discord del departamento."

#: models/config.py:153
msgctxt "aa_ticket"
msgid "remind after (minutes)"
msgstr "recordar tras (minutos)"

#: models/config.py:157
msgctxt "aa_ticket"
msgid ""
"Mention the department again if nobody claims the ticket in time. Leave "
"empty to turn off."
msgstr ""
"Menciona de nuevo al departamento si nadie asume el ticket a tiempo. Déjalo "
"vacío para desactivarlo."

#: models/config.py:160
msgctxt "aa_ticket"
msgid "escalate after (minutes)"
msgstr "escalar tras (minutos)"

#: models/config.py:164
msgctxt "aa_ticket"
msgid ""
"Mention the parent department if nobody claims the ticket in time. Leave "
"empty to turn off."
msgstr ""
"Menciona al departamento superior si nadie asume el ticket a tiempo. Déjalo "
"vacío para desactivarlo."

