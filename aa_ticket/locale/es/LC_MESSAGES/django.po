msgid "Shown to players when they pick a department."
msgstr "Se muestra a los jugadores al elegir un departamento."

#: models/config.py:45
msgctxt "aa_ticket"
msgid "parent department"
msgstr "departamento superior"

#: models/config.py:50
msgctxt "aa_ticket"
msgid "Staff of the parent department can see all tickets of this department."
msgstr ""
"El personal del departamento superior puede ver todos los tickets de este "
"departamento."

#: models/config.py:54
msgctxt "aa_ticket"
msgid "staff groups"
msgstr "grupos de personal"

#: models/config.py:57
msgctxt "aa_ticket"
