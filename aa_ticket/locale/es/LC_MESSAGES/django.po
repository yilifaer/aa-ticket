#: models/config.py:92 models/config.py:185 models/config.py:211
msgctxt "aa_ticket"
msgid "department"
msgstr "departamento"

#: models/config.py:93
msgctxt "aa_ticket"
msgid "departments"
msgstr "departamentos"

#: models/config.py:128
msgctxt "aa_ticket"
msgid "A department cannot be its own parent."
msgstr "Un departamento no puede ser su propio departamento superior."

#: models/config.py:131
msgctxt "aa_ticket"
msgid "This parent would create a loop. Pick a department above this one."
msgstr ""
"Este departamento superior crearía un bucle. Elige un departamento por "
"encima de este."

#: models/config.py:145
msgctxt "aa_ticket"
msgid "colour"
msgstr "color"

#: models/config.py:146
msgctxt "aa_ticket"
msgid "Higher means more urgent."
msgstr "Un valor más alto es más urgente."

#: models/config.py:148
msgctxt "aa_ticket"
msgid "mention roles for new tickets"
msgstr "mencionar roles en tickets nuevos"

#: models/config.py:150
msgctxt "aa_ticket"
msgid ""
"When on, new tickets with this priority mention the department's Discord "
"roles."
msgstr ""
"Si está activado, los tickets nuevos con esta prioridad mencionan los roles "
"de Discord del departamento."

#: models/config.py:153
msgctxt "aa_ticket"
msgid "remind after (minutes)"
msgstr "recordar tras (minutos)"

#: models/config.py:157
msgctxt "aa_ticket"
msgid ""
"Mention the department again if nobody claims the ticket in time. Leave "
"empty to turn off."
msgstr ""
"Menciona de nuevo al departamento si nadie asume el ticket a tiempo. Déjalo "
"vacío para desactivarlo."

#: models/config.py:160
msgctxt "aa_ticket"
msgid "escalate after (minutes)"
msgstr "escalar tras (minutos)"

#: models/config.py:164
msgctxt "aa_ticket"
msgid ""
"Mention the parent department if nobody claims the ticket in time. Leave "
"empty to turn off."
msgstr ""
"Menciona al departamento superior si nadie asume el ticket a tiempo. Déjalo "
"vacío para desactivarlo."

#: models/config.py:167
msgctxt "aa_ticket"
msgid "counts as urgent"
msgstr "cuenta como urgente"

#: models/config.py:169
msgctxt "aa_ticket"
msgid ""
"Urgent tickets are listed first and highlighted on the overview and the "
"Alliance Auth dashboard."
msgstr ""
"Los tickets urgentes aparecen primero y se destacan en el resumen y en el "
"panel de Alliance Auth."

#: models/config.py:176
msgctxt "aa_ticket"
msgid "priority"
msgstr "prioridad"

#: models/config.py:177
msgctxt "aa_ticket"
msgid "priorities"
msgstr "prioridades"

#: models/config.py:189
msgctxt "aa_ticket"
msgid "template"
msgstr "plantilla"

#: models/config.py:189
msgctxt "aa_ticket"
msgid "Pre-filled into the ticket text when a player picks this category."
msgstr ""
"Se rellena en el texto del ticket cuando un jugador elige esta categoría."

#: models/config.py:197
msgctxt "aa_ticket"
msgid "category"
msgstr "categoría"

#: models/config.py:198
msgctxt "aa_ticket"
msgid "categories"
msgstr "categorías"

#: models/config.py:212
msgctxt "aa_ticket"
msgid "Leave empty to share with all departments."
msgstr "Déjalo vacío para compartirlo con todos los departamentos."

#: models/config.py:214 models/tickets.py:12
msgctxt "aa_ticket"
msgid "title"
msgstr "título"

#: models/config.py:215
msgctxt "aa_ticket"
msgid "text"
msgstr "texto"

#: models/config.py:220
msgctxt "aa_ticket"
msgid "canned reply"
msgstr "respuesta predefinida"

#: models/config.py:221
msgctxt "aa_ticket"
msgid "canned replies"
msgstr "respuestas predefinidas"

#: models/config.py:229
msgctxt "aa_ticket"
msgid "auto-close after (days)"
msgstr "cierre automático tras (días)"

#: models/config.py:232
msgctxt "aa_ticket"
msgid ""
"Tickets waiting for the requester are closed automatically after this many "
"days without a reply."
msgstr ""
"Los tickets que esperan al solicitante se cierran automáticamente tras este "
"número de días sin respuesta."

#: models/config.py:235
msgctxt "aa_ticket"
msgid "warn before auto-close (hours)"
msgstr "avisar antes del cierre automático (horas)"

#: models/config.py:237
msgctxt "aa_ticket"
msgid ""
"The requester and the assignee are warned this many hours before a ticket "
"closes automatically."
msgstr ""
"El solicitante y el responsable reciben un aviso este número de horas antes "
"de que un ticket se cierre automáticamente."

#: models/config.py:240
msgctxt "aa_ticket"
msgid "requester can reopen for (days)"
msgstr "el solicitante puede reabrir durante (días)"

#: models/config.py:242
msgctxt "aa_ticket"
msgid ""
"For this many days after closing, the requester can reopen the ticket. Staff "
"can always reopen."
msgstr ""
"Durante este número de días tras el cierre, el solicitante puede reabrir el "
"ticket. El personal siempre puede reabrirlo."

#: models/config.py:245
msgctxt "aa_ticket"
msgid "open tickets per person"
msgstr "tickets abiertos por persona"

#: models/config.py:248
msgctxt "aa_ticket"
msgid ""
"A person cannot submit a new ticket while this many of their tickets are "
"still open."
msgstr ""
"Una persona no puede enviar un ticket nuevo mientras tenga abiertos este "
"número de tickets."

#: models/config.py:251
msgctxt "aa_ticket"
msgid "maximum image size (MB)"
msgstr "tamaño máximo de imagen (MB)"

#: models/config.py:254
msgctxt "aa_ticket"
msgid "delete images after (days)"
msgstr "eliminar imágenes tras (días)"

#: models/config.py:257
msgctxt "aa_ticket"
msgid ""
"Images of tickets closed longer than this are deleted. Leave empty to keep "
"them forever."
msgstr ""
"Se eliminan las imágenes de los tickets cerrados hace más tiempo que esto. "
"Déjalo vacío para conservarlas siempre."

#: models/config.py:260 models/config.py:289 templates/aa_ticket/prefs.html:13
msgctxt "aa_ticket"
msgid "Discord direct messages"
msgstr "Mensajes directos de Discord"

#: models/config.py:262
msgctxt "aa_ticket"
msgid ""
"When on and aa-discordbot is installed, people also get notifications as "
"Discord direct messages."
msgstr ""
"Si está activado y aa-discordbot está instalado, las personas también "
"reciben notificaciones como mensajes directos de Discord."

#: models/config.py:265
msgctxt "aa_ticket"
msgid "Language of Discord channel messages"
msgstr "Idioma de los mensajes del canal de Discord"

#: models/config.py:269
msgctxt "aa_ticket"
msgid "All messages posted to department channels use this language."
msgstr ""
"Todos los mensajes publicados en los canales de los departamentos usan este "
"idioma."

#: models/config.py:272
msgctxt "aa_ticket"
msgid "Language of Discord direct messages"
msgstr "Idioma de los mensajes directos de Discord"

#: models/config.py:276
msgctxt "aa_ticket"
msgid ""
"Direct messages can follow each person's language setting in Alliance Auth, "
"or use the channel language."
msgstr ""
"Los mensajes directos pueden seguir el idioma de cada persona en Alliance "
"Auth o usar el idioma del canal."

#: models/config.py:281
msgctxt "aa_ticket"
msgid "ticket settings"
msgstr "configuración de tickets"

