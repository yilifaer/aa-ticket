#: access.py:162
#, python-format
msgctxt "aa_ticket"
msgid "This ticket is handled by %(name)s. You can write an internal note."
msgstr "这张工单由 %(name)s 处理，你可以写内部备注。"

#: access.py:168
msgctxt "aa_ticket"
msgid ""
"Your department is helping with this ticket. You can write an internal note; "
"the responsible department replies to the requester."
msgstr "你的部门在协助这张工单，可以写内部备注；回复提交人由负责部门来做。"

#: access.py:171
msgctxt "aa_ticket"
msgid "Claim the ticket to reply to the requester."
msgstr "接手后才能回复提交人。"

#: attachments.py:49
msgctxt "aa_ticket"
msgid "Only PNG, JPG, GIF and WEBP images are allowed."
msgstr "仅支持 PNG、JPG、GIF 和 WEBP 图片。"

#: attachments.py:57
#, python-format
msgctxt "aa_ticket"
msgid ""
"This image is too large (%(width)d × %(height)d pixels). Images up to "
"%(max)d megapixels are accepted. Please use a smaller image."
msgstr ""
"图片太大（%(width)d × %(height)d 像素）。最大支持 %(max)d 百万像素，请换一张"
"更小的图片。"

#: attachments.py:62
msgctxt "aa_ticket"
msgid "This image is too large. Please make it smaller and try again."
msgstr "图片尺寸过大，请缩小后再上传。"

#: attachments.py:69
#, python-format
msgctxt "aa_ticket"
msgid ""
"This animation is too large in total (%(count)d frames of %(width)d × "
"%(height)d pixels). All frames together may have up to %(max)d megapixels. "
"Use fewer frames or a smaller size."
msgstr ""
"这个动图总量太大（%(count)d 帧，每帧 %(width)d × %(height)d 像素）。所有帧加"
"起来最多 %(max)d 百万像素，请减少帧数或缩小尺寸。"

#: attachments.py:105
#, python-format
msgctxt "aa_ticket"
msgid ""
"This animation has too many frames (%(count)d). Up to %(max)d frames are "
"allowed."
msgstr "这个动图的帧数太多（%(count)d 帧），最多允许 %(max)d 帧。"

#: attachments.py:134 attachments.py:210
#, python-format
msgctxt "aa_ticket"
msgid "You can attach at most %(count)d images per message."
msgstr "每条消息最多附加 %(count)d 张图片。"

#: attachments.py:139 attachments.py:216
#, python-format
msgctxt "aa_ticket"
msgid "Each image must be smaller than %(size)d MB."
msgstr "每张图片必须小于 %(size)d MB。"

