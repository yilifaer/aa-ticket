#: discord/webhook.py:34
msgctxt "aa_ticket"
msgid ""
"Paste the full webhook URL from Discord. It starts with "
"https://discord.com/api/webhooks/"
msgstr ""
"Вставьте полный URL вебхука из Discord. Он начинается с "
"https://discord.com/api/webhooks/"

#: discord/webhook.py:42
msgctxt "aa_ticket"
msgid "New ticket"
msgstr "Новая заявка"

#: discord/webhook.py:44
#, python-format
msgctxt "aa_ticket"
msgid "Ticket transferred to %(department)s"
msgstr "Заявка передана в отдел «%(department)s»"

#: discord/webhook.py:46
#, python-format
msgctxt "aa_ticket"
msgid "%(department)s was invited to help"
msgstr "Отдел «%(department)s» приглашён помочь"

#: discord/webhook.py:48
#, python-format
msgctxt "aa_ticket"
msgid "The requester asked %(department)s to step in"
msgstr "Автор просил отдел «%(department)s» подключиться"

#: discord/webhook.py:50
msgctxt "aa_ticket"
msgid "Still unclaimed — please take a look"
msgstr "Заявка всё ещё не взята в работу — посмотрите, пожалуйста"

#: discord/webhook.py:52
#, python-format
