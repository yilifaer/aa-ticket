#: models/config.py:172
msgid "priorities"
msgstr "приоритеты"

#: models/config.py:184
msgid "template"
msgstr "шаблон"

#: models/config.py:184
msgid "Pre-filled into the ticket text when a player picks this category."
msgstr "Подставляется в текст заявки, когда игрок выбирает эту категорию."

#: models/config.py:192
msgid "category"
msgstr "категория"

#: models/config.py:193
msgid "categories"
msgstr "категории"

#: models/config.py:207
msgid "Leave empty to share with all departments."
