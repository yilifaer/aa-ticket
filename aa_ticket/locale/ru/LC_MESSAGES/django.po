msgid "A ticket of %(department)s is still unclaimed"
msgstr "Заявка отдела «%(department)s» всё ещё не взята в работу"

#: discord/webhook.py:54
msgctxt "aa_ticket"
msgid "The assignee left the department — the ticket needs a new handler"
msgstr "Исполнитель покинул отдел — заявке нужен новый исполнитель"

#: discord/webhook.py:56
msgctxt "aa_ticket"
msgid "The requester is still waiting for a reply"
msgstr "Автор всё ещё ждёт ответа"

