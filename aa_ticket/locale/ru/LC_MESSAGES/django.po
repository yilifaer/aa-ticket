#: attachments.py:38
msgctxt "aa_ticket"
msgid "Only PNG, JPG, GIF and WEBP images are allowed."
msgstr "Допускаются только изображения PNG, JPG, GIF и WEBP."

#: attachments.py:44
#, python-format
msgctxt "aa_ticket"
msgid ""
"This image is too large (%(width)d × %(height)d pixels). Please make it "
"smaller and try again."
msgstr ""
"Изображение слишком большое (%(width)d × %(height)d пикселей). Уменьшите его"
" и попробуйте снова."

#: attachments.py:47
msgctxt "aa_ticket"
msgid "This image is too large. Please make it smaller and try again."
msgstr "Изображение слишком большое. Уменьшите его и попробуйте снова."

#: attachments.py:77
#, python-format
msgctxt "aa_ticket"
msgid "You can attach at most %(count)d images per message."
msgstr "В одном сообщении можно прикрепить не более %(count)d изображений."

#: attachments.py:82
#, python-format
msgctxt "aa_ticket"
msgid "Each image must be smaller than %(size)d MB."
msgstr "Каждое изображение должно быть меньше %(size)d МБ."

