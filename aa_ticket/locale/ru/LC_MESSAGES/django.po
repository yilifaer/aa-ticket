msgid "%(name)s is now handling your ticket."
msgstr "%(name)s теперь занимается вашей заявкой."

#: notifications.py:98
msgctxt "aa_ticket"
msgid "You were assigned this ticket."
msgstr "Вам назначена эта заявка."

