#: models/config.py:39 models/config.py:144 models/config.py:182
msgid "name"
msgstr "название"

#: models/config.py:41
msgid "description"
msgstr "описание"

#: models/config.py:41
msgid "Shown to players when they pick a department."
msgstr "Показывается игрокам при выборе отдела."

#: models/config.py:45
msgid "parent department"
msgstr "родительский отдел"

#: models/config.py:50
msgid "Staff of the parent department can see all tickets of this department."
msgstr "Сотрудники родительского отдела видят все заявки этого отдела."

#: models/config.py:54
msgid "staff groups"
msgstr "группы сотрудников"

#: models/config.py:57
msgid "Members of these groups are staff of this department."
msgstr "Участники этих групп являются сотрудниками этого отдела."

#: models/config.py:61
msgid "states allowed to submit"
msgstr "статусы, которым разрешено подавать заявки"

#: models/config.py:64
msgid "Leave both lists empty to allow everyone who can use tickets."
msgstr ""
"Оставьте оба списка пустыми, чтобы разрешить всем, кто может пользоваться "
"заявками."

#: models/config.py:68
msgid "groups allowed to submit"
msgstr "группы, которым разрешено подавать заявки"

#: models/config.py:73
msgid "accepts tickets from players"
msgstr "принимает заявки от игроков"

#: models/config.py:75
msgid ""
"When off, tickets can only reach this department by transfer or invitation."
msgstr ""
"Если выключено, заявки попадают в этот отдел только по передаче или "
"приглашению."

#: models/config.py:77 models/config.py:166 models/config.py:187
msgid "active"
msgstr "активен"

#: models/config.py:78 models/config.py:146 models/config.py:186
