#: access.py:162
#, python-format
msgctxt "aa_ticket"
msgid "This ticket is handled by %(name)s. You can write an internal note."
msgstr "Эту заявку ведёт %(name)s. Вы можете написать внутреннюю заметку."

#: access.py:168
msgctxt "aa_ticket"
msgid ""
"Your department is helping with this ticket. You can write an internal note; "
"the responsible department replies to the requester."
msgstr ""
"Ваш отдел помогает с этой заявкой. Вы можете написать внутреннюю заметку; "
"автору отвечает ответственный отдел."

#: access.py:171
msgctxt "aa_ticket"
msgid "Claim the ticket to reply to the requester."
msgstr "Возьмите заявку в работу, чтобы ответить автору."

#: attachments.py:49
msgctxt "aa_ticket"
msgid "Only PNG, JPG, GIF and WEBP images are allowed."
msgstr "Допускаются только изображения PNG, JPG, GIF и WEBP."

#: attachments.py:57
#, python-format
msgctxt "aa_ticket"
msgid ""
"This image is too large (%(width)d × %(height)d pixels). Images up to "
"%(max)d megapixels are accepted. Please use a smaller image."
msgstr ""
"Изображение слишком большое (%(width)d × %(height)d пикселей). Принимаются "
"изображения до %(max)d мегапикселей. Используйте изображение поменьше."

#: attachments.py:62
msgctxt "aa_ticket"
msgid "This image is too large. Please make it smaller and try again."
msgstr "Изображение слишком большое. Уменьшите его и попробуйте снова."

#: attachments.py:69
#, python-format
msgctxt "aa_ticket"
msgid ""
"This animation is too large in total (%(count)d frames of %(width)d × "
"%(height)d pixels). All frames together may have up to %(max)d megapixels. "
"Use fewer frames or a smaller size."
msgstr ""
"Анимация слишком большая в сумме (кадров: %(count)d, каждый %(width)d × "
"%(height)d пикселей). Все кадры вместе могут занимать не более %(max)d "
"мегапикселей. Уменьшите число кадров или размер."

#: attachments.py:105
#, python-format
msgctxt "aa_ticket"
msgid ""
"This animation has too many frames (%(count)d). Up to %(max)d frames are "
"allowed."
msgstr ""
"В этой анимации слишком много кадров (%(count)d). Допускается не больше "
"%(max)d."

#: attachments.py:134 attachments.py:210
#, python-format
msgctxt "aa_ticket"
msgid "You can attach at most %(count)d images per message."
msgstr "В одном сообщении можно прикрепить не более %(count)d изображений."

#: attachments.py:139 attachments.py:216
#, python-format
msgctxt "aa_ticket"
msgid "Each image must be smaller than %(size)d MB."
msgstr "Каждое изображение должно быть меньше %(size)d МБ."

